# Copia este archivo como ".env" y ajusta los valores.
PORT=3000
NODE_ENV=development

# Base de datos SQLite (ruta del archivo, relativa a la carpeta backend/)
DB_PATH=../database/masaya.db

# Secreto para firmar los JWT. En producción DEBE ser largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRA=8h

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGENES=http://localhost:5500,http://127.0.0.1:5500

# Fotografías
UPLOADS_DIR=uploads
MAX_FOTO_MB=5

# Rechazar reportes cuya ubicación esté fuera del municipio de Masaya
VALIDAR_ZONA=true

# true cuando el backend esté detrás de un proxy (Render, Railway, Nginx)
TRUST_PROXY=false
