                  "const r = pm.response.json();",
                  "pm.test(\"código de seguimiento\", () => pm.expect(r.codigo).to.match(/^MSY-[A-Z]{2}\\d{4}$/));",
                  "pm.collectionVariables.set(\"codigo\", r.codigo); pm.collectionVariables.set(\"reporteId\", r.id);"
